# =============================================================================
# Avably — STOREFRONT — szablon zmiennych środowiskowych
# =============================================================================
# Skopiuj do `.env.local` (niecommitowany) i uzupełnij WŁASNYMI wartościami.
# Ten plik zawiera WYŁĄCZNIE nazwy + placeholdery — ZERO realnych sekretów.
# Pełny opis (przeznaczenie, sekret, build-time/runtime): docs/operacje/spis-env-avably.md
#
# NEXT_PUBLIC_* = stała BUILD-TIME (wmurowana w bundle klienta przy `next build`).
#   Zmiana wymaga PRZEBUDOWY — restart procesu nic nie zmienia.
# Pozostałe = runtime serwera; sekrety trzymaj jako sensitive w Vercelu.
# Prefiks AVABLY_ jest ŚWIADOMY: przestrzenie STRIPE_*/VERCEL_* należą do dostawcy
#   i systemowe zmienne Vercela przykryłyby nasze wartości (ADR-049).
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Adres API projektu (klient + serwer). Publiczny.
NEXT_PUBLIC_SUPABASE_URL=
# Klucz publikowalny (nowy format). Preferowany nad anon. Chroniony RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key — fallback dla publishable. Zostaw do migracji na publishable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# UWAGA: storefront NIE ma klucza sekretnego serwera ani roli serwisowej Supabase
# (bramka ADR-142 tego pilnuje) — publiczny sklep działa WYŁĄCZNIE przez RLS
# z kluczem publikowalnym/anon. Sekrety serwera należą do panelu, nie tutaj.

# --- Stripe (platformowe konto; prefiks AVABLY_ — NIE STRIPE_*) ---------------
# SEKRET. Sekretny klucz platformowego Stripe (tworzenie sesji checkoutu najemcy).
AVABLY_STRIPE_SECRET_KEY=
# Klucz publikowalny Stripe (wydawany z serwera na checkout). Serwerowy — bez NEXT_PUBLIC_.
AVABLY_STRIPE_PUBLISHABLE_KEY=

# --- Resend (maile transakcyjne) ---------------------------------------------
# SEKRET. Klucz API Resend. Bez niego transport odmawia wysyłki.
RESEND_API_KEY=
# Nadpisanie adresu nadawcy. Ustaw zweryfikowany adres (domyślna wartość = odmowa dostawcy).
RESEND_FROM_EMAIL=

# --- Upstash Redis (rate limit) ----------------------------------------------
# Endpoint REST. Adres.
UPSTASH_REDIS_REST_URL=
# SEKRET. Token REST.
UPSTASH_REDIS_REST_TOKEN=

# --- Turnstile (CAPTCHA) -----------------------------------------------------
# Klucz witryny widgetu (klient). Publiczny.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SEKRET. Sekret serwerowej weryfikacji. Usunięcie CICHO wyłącza CAPTCHA — nie kasuj na prod.
TURNSTILE_SECRET_KEY=

# --- Podpis biletów (checkout + formularz kontaktowy; prefiks AVABLY_) --------
# SEKRET. Sekret podpisu biletów checkoutu (serwerowy — bez NEXT_PUBLIC_).
AVABLY_CHECKOUT_TICKET_SECRET=
# SEKRET. Sekret podpisu biletów formularza kontaktowego.
AVABLY_FORM_TICKET_SECRET=

# --- Przegląd uwag (funkcja opcjonalna) --------------------------------------
# SEKRET. Współdzielony sekret storefront ↔ panel dla wsadu uwag (ta sama wartość po obu stronach).
REVIEW_INGEST_TOKEN=
# Adres endpointu wsadu uwag w panelu (cel relay).
REVIEW_INGEST_URL=

# =============================================================================
# SYSTEMOWE dostawcy — NIE ustawiaj ręcznie (Vercel/Node robią to same):
#   VERCEL, NODE_ENV
# Definiowanie ich = kolizja (ADR-049).
# =============================================================================

# --- LOKALNE / CI (testy integracyjne — NIE dodawaj do Vercela) --------------
# Connection string lokalnej bazy (NIE adres API). Zła wartość = timeouty 20 s.
SUPABASE_LOCAL_URL=
# Adres API lokalnego Supabase.
SUPABASE_LOCAL_API_URL=
# Anon key lokalnego Supabase (demo).
SUPABASE_LOCAL_ANON_KEY=
# Service role lokalnego Supabase (demo — nie produkcyjny sekret).
SUPABASE_LOCAL_SERVICE_ROLE_KEY=
# Pozwala suitom integracyjnym pominąć się bez env lokalnego Supabase (strażnik CI).
ALLOW_INTEGRATION_SKIP=
# Port atrapy Stripe w e2e.
E2E_STRIPE_STUB_PORT=
# Flaga diagnostyczna raportu w teście integracyjnym (kandydat do przeglądu).
FAZA4A_RAPORT=
