# =============================================================================
# Avably — PANEL — szablon zmiennych środowiskowych
# =============================================================================
# Skopiuj do `.env.local` (niecommitowany) i uzupełnij WŁASNYMI wartościami.
# Ten plik zawiera WYŁĄCZNIE nazwy + placeholdery — ZERO realnych sekretów.
# Pełny opis (przeznaczenie, sekret, build-time/runtime): docs/operacje/spis-env-avably.md
#
# NEXT_PUBLIC_* = stała BUILD-TIME (wmurowana w bundle klienta przy `next build`).
#   Zmiana wymaga PRZEBUDOWY — restart procesu nic nie zmienia.
# Pozostałe = runtime serwera; sekrety trzymaj jako sensitive w Vercelu.
# Prefiks AVABLY_ jest ŚWIADOMY: przestrzenie STRIPE_*/VERCEL_* należą do dostawcy
#   i systemowe zmienne Vercela przykryłyby nasze wartości (ADR-049).
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Adres API projektu (klient + serwer). Publiczny.
NEXT_PUBLIC_SUPABASE_URL=
# Klucz publikowalny (nowy format). Preferowany nad anon. Chroniony RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key — fallback dla publishable. Zostaw do migracji na publishable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SEKRET. Sekretny klucz serwera (sb_secret_…), omija RLS. Wygrywa nad service role.
SUPABASE_SECRET_KEY=
# SEKRET. Legacy service role — fallback dla SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# --- Szyfrowanie sekretów najemców (ADR-052; KRYTYCZNE dla DR) ----------------
# Numer wersji klucza, którym SZYFRUJEMY nowe sekrety. Liczba całkowita >= 1.
AVABLY_SECRETS_KEY_CURRENT=1
# SEKRET. Materiał klucza AES-256 wersji N — base64 z DOKŁADNIE 32 bajtów.
# Bez klucza danej wersji koperty (v1:<wersja>:...) są NIEODWRACALNIE nieczytelne.
# Rotacja: dołóż AVABLY_SECRETS_KEY_V2 i przestaw AVABLY_SECRETS_KEY_CURRENT=2.
AVABLY_SECRETS_KEY_V1=

# --- Stripe (platformowe konto; prefiks AVABLY_ — NIE STRIPE_*) ---------------
# SEKRET. Sekretny klucz platformowego Stripe.
AVABLY_STRIPE_SECRET_KEY=
# Klucz publikowalny Stripe (wydawany z serwera na checkout). Serwerowy — bez NEXT_PUBLIC_.
AVABLY_STRIPE_PUBLISHABLE_KEY=
# SEKRET. Sekret podpisu webhooka Stripe (Connect / direct charge).
AVABLY_STRIPE_WEBHOOK_SECRET=
# SEKRET. Sekret podpisu wariantu thin-payload webhooka (opcjonalny, uzupełnia powyższy).
AVABLY_STRIPE_WEBHOOK_SECRET_THIN=
# SEKRET. Sekret podpisu webhooka subskrypcji platformy (Stripe Billing).
AVABLY_STRIPE_BILLING_WEBHOOK_SECRET=

# --- Resend (maile transakcyjne) ---------------------------------------------
# SEKRET. Klucz API Resend. Bez niego transport odmawia wysyłki.
RESEND_API_KEY=
# Nadpisanie adresu nadawcy. Ustaw zweryfikowany adres (domyślna wartość = odmowa dostawcy).
RESEND_FROM_EMAIL=

# --- Upstash Redis (rate limit) ----------------------------------------------
# Endpoint REST. Adres.
UPSTASH_REDIS_REST_URL=
# SEKRET. Token REST — panel potrzebuje PEŁNEGO tokenu (redis.del).
UPSTASH_REDIS_REST_TOKEN=

# --- Turnstile (CAPTCHA) -----------------------------------------------------
# Klucz witryny widgetu (klient). Publiczny.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SEKRET. Sekret serwerowej weryfikacji. Usunięcie CICHO wyłącza CAPTCHA — nie kasuj na prod.
TURNSTILE_SECRET_KEY=

# --- Cron / joby -------------------------------------------------------------
# SEKRET. Bearer autoryzujący Vercel Cron → trasy /api/jobs/*.
CRON_SECRET=

# --- Rejestracja domen sklepów (Vercel API; prefiks AVABLY_ — NIE VERCEL_*) ---
# SEKRET. Token API Vercela do rejestracji hostów sklepów.
AVABLY_VERCEL_API_TOKEN=
# Id projektu STOREFRONTU (cel rejestracji). NIE id panelu (bramka anty-samorejestracja).
AVABLY_STOREFRONT_PROJECT_ID=
# Id zespołu Vercela (opcjonalny — konto osobiste go nie ma).
AVABLY_VERCEL_TEAM_ID=

# --- Rejestry firm: NIP → dane, biała lista VAT ------------------------------
# SEKRET. Klucz użytkownika GUS BIR (opcjonalny — bez niego degradacja do samego MF).
GUS_BIR_USER_KEY=
# Środowisko GUS BIR: "test" → publiczny klucz testowy; brak → produkcja.
GUS_BIR_ENV=
# Nadpisanie bazowego URL API białej listy VAT (MF). Opcjonalne — ma domyślną wartość.
MF_WHITELIST_BASE_URL=
# SEKRET. Potwierdza, że zapisu cache NIP dokonuje NASZ panel. Nigdy NEXT_PUBLIC_.
REGISTRY_CACHE_WRITE_SECRET=

# --- Webhook email-hook Supabase Auth ----------------------------------------
# SEKRET. Weryfikacja podpisu webhooka email-hook (maile auth).
SUPABASE_EMAIL_HOOK_SECRET=

# --- Wyszukiwarka zdjęć (panel) ----------------------------------------------
# SEKRET. Klucz API Unsplash (opcjonalny — bez niego image-picker Unsplash niedostępny).
UNSPLASH_ACCESS_KEY=

# --- Strona / marka ----------------------------------------------------------
# Kanoniczny adres strony marketingowej (derywacja marki/adresu nadawcy). Opcjonalny — ma default.
NEXT_PUBLIC_SITE_URL=

# --- Przegląd uwag (superadmin; funkcja opcjonalna) --------------------------
# Flaga trybu przeglądu. "1" włącza nakładkę/bramki; domyślnie WYŁĄCZONA na prod.
REVIEW_MODE=
# SEKRET. Współdzielony sekret storefront ↔ panel dla wsadu uwag (ta sama wartość po obu stronach).
REVIEW_INGEST_TOKEN=
# Adres storefrontu dla nakładki przeglądu (iframe).
REVIEW_STOREFRONT_URL=
# Adres sklepu najemcy dla nakładki przeglądu.
REVIEW_TENANT_URL=

# =============================================================================
# SYSTEMOWE dostawcy — NIE ustawiaj ręcznie (Vercel/Node robią to same):
#   VERCEL, VERCEL_PROJECT_ID, NODE_ENV
# Definiowanie ich = kolizja (ADR-049).
# =============================================================================

# --- LOKALNE / CI (testy integracyjne — NIE dodawaj do Vercela) --------------
# Connection string lokalnej bazy (NIE adres API). Zła wartość = timeouty 20 s.
SUPABASE_LOCAL_URL=
# Adres API lokalnego Supabase.
SUPABASE_LOCAL_API_URL=
# Anon key lokalnego Supabase (demo).
SUPABASE_LOCAL_ANON_KEY=
# Service role lokalnego Supabase (demo — nie produkcyjny sekret).
SUPABASE_LOCAL_SERVICE_ROLE_KEY=
# Pozwala suitom integracyjnym pominąć się bez env lokalnego Supabase (strażnik CI).
ALLOW_INTEGRATION_SKIP=
