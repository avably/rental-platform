msgid "Online booking is temporarily unavailable. Please contact us directly."
msgstr "Rezerwacja online jest chwilowo niedostępna. Skontaktuj się z nami bezpośrednio."

msgid "The store is currently unavailable. Please try again later."
msgstr "Sklep jest w tej chwili niedostępny. Spróbuj ponownie później."

msgid "Too many requests. Please wait a moment and try again."
msgstr "Zbyt wiele żądań. Odczekaj chwilę i spróbuj ponownie."

msgid "Please check the highlighted fields and try again."
msgstr "Sprawdź zaznaczone pola i spróbuj ponownie."

msgid "This product is no longer available."
msgstr "Ten produkt nie jest już dostępny."

msgid "The selected dates have just been taken. Please refresh availability and pick different dates."
msgstr "Wybrane terminy zostały właśnie zajęte. Odśwież dostępność i wybierz inne daty."

msgid "The reservation could not be processed. Please verify your details and try again."
msgstr "Nie udało się przetworzyć rezerwacji. Sprawdź dane i spróbuj ponownie."

msgid "Online payment is currently unavailable. Please choose a different payment method."
msgstr "Płatność online jest w tej chwili niedostępna. Wybierz inną metodę płatności."

msgid "Something went wrong. Please try again later."
msgstr "Coś poszło nie tak. Spróbuj ponownie później."

