{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@avably/db": ["../../packages/db/src/index.ts"],
      "@avably/core": ["../../packages/core/src/index.ts"],
      "@avably/security": ["../../packages/security/src/index.ts"],
      "@avably/ui": ["../../packages/ui/src/index.ts"]
    }
  }
}
