al<!-- -->:</strong> <!-- -->PLN 550.00</p></td></tr></tbody></table><hr style="width:100%;border:none;border-color:#e8e8e8;border-top:1px solid #eaeaea;margin:28px 0 20px"/><p style="font-size:12px;line-height:1.6;color:#555555;margin:0;text-align:center;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">North Rental<br/>This is an automated message about your rental.</p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>",
